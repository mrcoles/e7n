{
  "name": "e7n",
  "description": "A tool for Chrome extensions i18n/l10n to auto-populate _locales/<default_locale>/messages.json with messages from JS and HTML files",
  "version": "1.7.5",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "bin/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrcoles/e7n.git"
  },
  "bin": {
    "e7n": "bin/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "watch": "npm run build -- -w",
    "test": "npm run build && ./bin/cli.js samples/"
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "css.escape": "^1.5.1",
    "estree-walker": "^2.0.2",
    "glob": "^13.0.6",
    "pseudo-localization": "^2.1.1"
  },
  "devDependencies": {
    "@babel/types": "^7.29.11",
    "@types/chrome": "^0.0.300",
    "@types/estree": "^1.0.10",
    "@types/node": "^20.19.43",
    "domhandler": "^5.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
